      <aliases enabled='yes' />
      <column caption='new id ' datatype='integer' name='[Calculation_0164942063628288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='Predicted Churn Customers' datatype='integer' name='[Calculation_0164942065696769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;IF [churn_prediction]=&quot;Customer has left the company&quot;&#13;&#10;THEN 1 END&#13;&#10;)' />
      </column>
      <column caption='Churn Rate %' datatype='integer' name='[Calculation_0164942066253826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [churn_prediction]=&quot;Customer has left the company&quot;&#13;&#10;THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Average Churn Probability' datatype='real' name='[Calculation_0164942067109891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([churn_probability])' />
      </column>
      <column caption='Risk Segmentation' datatype='string' name='[Calculation_0164942068826116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churn_probability] &gt;= 0.8 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF [churn_probability] &gt;= 0.5 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='High-Risk Customers Table ' datatype='string' name='[Calculation_0164942074163205]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churn_probability] &gt;= 0.8 THEN &quot;High&quot;&#13;&#10;ELSEIF [churn_probability] &gt;= 0.5 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
